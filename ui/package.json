    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "@7k-inari/ui-plugin-sdk": "^0.1.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "jsdom": "^25.0.1"
  }
}