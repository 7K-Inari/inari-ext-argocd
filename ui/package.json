{
  "name": "@inari/ext-argocd-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Inari ArgoCD reference UI extension: ClusterTab, InstanceActions, CatalogCard (Module Federation remote)",
  "scripts": {
    "postinstall": "node scripts/build-sdk.mjs",
    "dev": "inari-ui-ext dev ./src/index.tsx",
